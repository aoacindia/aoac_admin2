generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model CredentialLog {
  id        Int      @id @default(autoincrement())
  email     String
  password  String
  createdAt DateTime @default(now())

  @@index([email])
}

model LoginState {
  email        String   @id
  attemptCount Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Legacy tables retained in DB but unused by the Orders module.
model Order {
  id              Int         @id @default(autoincrement())
  orderBy         String
  customerId      Int?
  orderDate       DateTime
  deliveryCharges Decimal     @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([orderDate])
  @@index([customerId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

/// Import-friendly orders table matching ImportedOrder.csv columns exactly.
model ImportedOrder {
  id              String              @id
  orderDate       DateTime            @map("order_date")
  orderName       String              @map("order_name")
  deliveryCharges Decimal             @map("delivery_charges") @db.Decimal(12, 2)
  orderTotal      Decimal             @map("order_total") @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           ImportedOrderItem[]

  @@index([orderDate])
  @@index([orderName])
  @@map("imported_orders")
}

/// Import-friendly order items matching ImportedOrderItem.csv columns exactly.
model ImportedOrderItem {
  id        String        @id
  orderId   String        @map("order_id")
  lineIndex Int           @map("line_index")
  itemName  String        @map("item_name")
  amount    Decimal       @db.Decimal(12, 2)
  order     ImportedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("imported_order_items")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailAccount {
  id           Int      @id @default(autoincrement())
  emailAddress String   @unique
  passwordHash String
  status       String   @default("active")
  isSuspended  Boolean  @default(false)
  storageUsed  String   @default("1 MB")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  forwardsFrom EmailForward[] @relation("ForwardFrom")
  forwardsTo   EmailForward[] @relation("ForwardTo")
}

model EmailForward {
  id             Int          @id @default(autoincrement())
  fromAccountId  Int
  toAccountId    Int?
  toAddress      String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  fromAccount    EmailAccount @relation("ForwardFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount      EmailAccount? @relation("ForwardTo", fields: [toAccountId], references: [id], onDelete: SetNull)

  @@index([fromAccountId])
  @@index([toAccountId])
}

/// Soft-hides demo Admin Accounts listings without deleting real auth users.
model HiddenAdminAccount {
  email     String   @id
  hiddenBy  String?
  hiddenAt  DateTime @default(now())
}

/// Persists demo server Running/Stopped status.
model DemoServerState {
  serverId  String   @id
  status    String   @default("Running")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Soft-hides demo Domains listings.
model HiddenDomain {
  domainId  String   @id
  hiddenBy  String?
  hiddenAt  DateTime @default(now())
}
